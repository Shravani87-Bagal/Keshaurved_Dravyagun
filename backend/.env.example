# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (Supabase connection string in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dravyaguna

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Dev import: set herbs to reviewed so clinician search returns them
IMPORT_DEFAULT_STATUS=reviewed

# Load test (optional overrides)
LOADTEST_BASE_URL=http://127.0.0.1:4000
LOADTEST_EMAIL=loadtest@dravyaguna.local
LOADTEST_PASSWORD=loadtest-password-change-me

# Translation / RAG (Phase 3+)
# SARVAM_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=
# AZURE_TRANSLATOR_KEY=
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
